<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_krioza_category_form" model="ir.ui.view">
        <field name="name">krioza.category.form</field>
        <field name="model">krioza.category</field>
        <field name="arch" type="xml">
            <form string="Krioza Category">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <group>
                        <field name="course_ids" readonly="1">
                            <list string="Courses">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="duration"/>
                                <field name="level" widget="badge"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_krioza_category_list" model="ir.ui.view">
        <field name="name">krioza.category.list</field>
        <field name="model">krioza.category</field>
        <field name="arch" type="xml">
            <list string="Krioza Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--  Search view  -->
    <record id="view_krioza_course_search" model="ir.ui.view">
        <field name="name">krioza.course.search</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name" string="Course" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="description"/>

                <separator/>

                <filter name="filter_online" string="Online" domain="[('online', '=', True)]"/>
                <filter name="filter_offline" string="Offline" domain="[('online', '=', False)]"/>

                <separator/>

                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_by_trainer" string="Trainer" context="{'group_by': 'trainer_id'}"/>
                <filter name="group_by_level" string="Level" context="{'group_by': 'level'}"/>
            </search>
        </field>
    </record>
    <!-- Course List View -->
    <record id="view_krioza_course_list" model="ir.ui.view">
        <field name="name">krioza.course.list</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="online" widget="boolean_toggle"/>
                <field name="level" widget="badge"/>
                <field name="category_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>


    <!-- Course Form View -->
    <record id="view_krioza_course_form" model="ir.ui.view">
        <field name="name">krioza.course.form</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Course Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="level"/>
                            <field name="duration"/>
                            <field name="online"/>
                        </group>
                        <group>
                            <field name="trainer_id"/>
                            <field name="category_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Course description..."/>
                        </page>
                        <page string="Syllabus">
                            <field name="syllabus" placeholder="Course syllabus..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action   -->
    <record id="action_krioza_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">krioza.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_krioza_course_search"/>
    </record>

    <!--  Menus -->
    <menuitem id="menu_krioza_root" name="Krioza" sequence="10"/>
    <menuitem id="menu_krioza_course" name="Courses" parent="menu_krioza_root" action="action_krioza_course" sequence="10"/>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Search -->
    <record id="view_krioza_course_search" model="ir.ui.view">
        <field name="name">krioza.course.search</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name" filter_domain="[('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <filter name="online" string="Online Courses" domain="[('online', '=', True)]"/>
                <filter name="offline" string="Offline Courses" domain="[('online', '=', False)]"/>
                <filter name="start_date" string="Starting Soon" domain="[('start_date', '&gt;=', context_today())]"/>
            </search>
        </field>
    </record>

    <!-- Course List View -->
    <record id="view_krioza_course_list" model="ir.ui.view">
        <field name="name">krioza.course.list</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="duration"/>
                <field name="online" widget="boolean_toggle"/>
                <field name="level" widget="badge"/>
                <field name="category_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>


    <!-- Course Form View -->
    <record id="view_krioza_course_form" model="ir.ui.view">
        <field name="name">krioza.course.form</field>
        <field name="model">krioza.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Course Name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group>
                        <field name="level" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="online" widget="checkbox"/>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="category_id" options="{'no_create': False, 'no_open': False}"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Course description..."/>
                        </page>
                        <page string="Syllabus">
                            <field name="syllabus" placeholder="Course syllabus..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Window Action -->
    <record id="action_krioza_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">krioza.course</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem id="menu_krioza_root" name="Krioza" sequence="10" />

    <menuitem id="menu_krioza_courses" name="Courses" parent="menu_krioza_root" action="action_krioza_courses" sequence="10" />

</odoo>